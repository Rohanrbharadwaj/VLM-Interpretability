},"papermill":{"duration":335.614213,"end_time":"2026-09-22T17:20:29.438169+00:00","exception":false,"start_time":"2026-09-22T17:14:53.823956+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["attribute  yes_id=3869 purity=1.0 | no_id=1939 purity=1.0\n","object     yes_id=3869 purity=1.0 | no_id=1939 purity=1.0\n","relation   yes_id=3869 purity=1.0 | no_id=1939 purity=1.0\n"]}],"source":["def batch_number(path):\n","    return int(re.search(r\"_batch_(\\d+)\\.pt$\", path).group(1))\n","\n","\n","def load_answer_logits(t):\n","    files = sorted(glob.glob(f\"{INPUT}/question-aware-cache-{t}/{t}_batch_*.pt\"), key=batch_number)\n","    qids, logits = [], []\n","    for path in files:\n","        batch = torch.load(path, mmap=True)\n","        for e in batch:\n","            qids.append(e[\"question_id\"])\n","            logits.append(e[\"answer_logits\"])\n","        del batch\n","    return qids, torch.stack(logits)\n","\n","\n","gap_frames = []\n","for t in TYPES:\n","    qids, logits = load_answer_logits(t)\n","    order = pd.DataFrame({\"question_id\": qids, \"row\": range(len(qids))})\n","    sub = labels.merge(order, on=\"question_id\")\n","    argmax_ids = logits.argmax(dim=1).numpy()\n","\n","    yes_ids = argmax_ids[sub.loc[sub.model_answer == \"yes\", \"row\"].to_numpy()]\n","    no_ids = argmax_ids[sub.loc[sub.model_answer == \"no\", \"row\"].to_numpy()]\n","    yes_id, no_id = int(pd.Series(yes_ids).mode()[0]), int(pd.Series(no_ids).mode()[0])\n","    print(f\"{t:10s} yes_id={yes_id} purity={round((yes_ids == yes_id).mean(), 4)} | \"\n","          f\"no_id={no_id} purity={round((no_ids == no_id).mean(), 4)}\")\n","\n","    gap = (logits[:, yes_id].float() - logits[:, no_id].float()).numpy()\n","    gap_frames.append(pd.DataFrame({\"question_id\": qids, \"logit_gap\": gap}))\n","    del logits\n","\n","labels = labels.merge(pd.concat(gap_frames, ignore_index=True), on=\"question_id\", how=\"left\")\n","assert labels[\"logit_gap\"].notna().all()"]},{"cell_type":"code","execution_count":3,"id":"265e30f8","metadata":{"execution":{"iopub.execute_input":"2026-09-22T17:20:29.444427Z","iopub.status.busy":"2026-09-22T17:20:29.444026Z","iopub.status.idle":"2026-09-22T17:20:29.46412Z","shell.execute_reply":"2026-09-22T17:20:29.462864Z"},"papermill":{"duration":0.02621,"end_time":"2026-09-22T17:20:29.466539+00:00","exception":false,"start_time":"2026-09-22T17:20:29.440329+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def _fit_eval(Xtr, ytr, Xval, yval, Xte, yte):\n","    result = {\"n_train\": len(ytr)}\n","    if ytr.nunique() < 2:\n","        return result\n","    clf = LogisticRegression(class_weight=\"balanced\", max_iter=2000)\n","    clf.fit(Xtr, ytr)\n","    for name, X, y in [(\"val\", Xval, yval), (\"test\", Xte, yte)]:\n","        if len(y) == 0 or y.nunique() < 2:\n","            continue\n","        pred, proba = clf.predict(X), clf.predict_proba(X)[:, 1]\n","        result[f\"{name}_bal_acc\"] = round(float(balanced_accuracy_score(y, pred)), 4)\n","        result[f\"{name}_auroc\"] = round(float(roc_auc_score(y, proba)), 4)\n","    return result\n","\n","\n","def eval_majority(df, y_col):\n","    out = {\"n_train\": (df.split == \"train\").sum(), \"val_bal_acc\": 0.5, \"test_bal_acc\": 0.5}\n","    for name in [\"val\", \"test\"]:\n","        sub = df[df.split == name]\n","        if len(sub) == 0:\n","            continue\n","        out[f\"{name}_majority_share\"] = round(max(sub[y_col].mean(), 1 - sub[y_col].mean()), 4)\n","    return out\n","\n","\n","def eval_source(df, y_col):\n","    dummies = pd.get_dummies(df[\"source\"])\n","    tr, va, te = df.split == \"train\", df.split == \"val\", df.split == \"test\"\n","    return _fit_eval(dummies[tr], df.loc[tr, y_col], dummies[va], df.loc[va, y_col], dummies[te], df.loc[te, y_col])\n","\n","\n","def eval_text(df, y_col):\n","    train, val, test = df[df.split == \"train\"], df[df.split == \"val\"], df[df.split == \"test\"]\n","    vec = TfidfVectorizer(ngram_range=(1, 2), min_df=2, max_features=5000)\n","    Xtr = vec.fit_transform(train[\"question_text\"])\n","    return _fit_eval(Xtr, train[y_col], vec.transform(val[\"question_text\"]), val[y_col],\n","                      vec.transform(test[\"question_text\"]), test[y_col])\n","\n","\n","def eval_vision(df, y_col, image_features):\n","    train, val, test = df[df.split == \"train\"], df[df.split == \"val\"], df[df.split == \"test\"]\n","    feat = lambda sub: np.stack([image_features[i][\"pooled_encoder_embedding\"].float().numpy() for i in sub[\"image_id\"]])\n","    Xtr, Xva, Xte = feat(train), feat(val), feat(test)\n","    scaler = StandardScaler().fit(Xtr)\n","    return _fit_eval(scaler.transform(Xtr), train[y_col], scaler.transform(Xva), val[y_col],\n","                      scaler.transform(Xte), test[y_col])\n","\n","\n","def safe_eval(fn, *args):\n","    try:\n","        return fn(*args)\n","    except Exception as e:\n","        return {\"error\": str(e)}\n","\n","\n","def eval_logit_gap(df):\n","    out = {}\n","    for name in [\"val\", \"test\"]:\n","        sub = df[df.split == name]\n","        if sub[\"false_yes\"].nunique() < 2:\n","            continue\n","        auc = roc_auc_score(sub[\"false_yes\"], sub[\"logit_gap\"])\n","        out[f\"{name}_auroc\"] = round(float(max(auc, 1 - auc)), 4)\n","    return out"]},{"cell_type":"code","execution_count":4,"id":"a6c13285","metadata":{"execution":{"iopub.execute_input":"2026-09-22T17:20:29.473253Z","iopub.status.busy":"2026-09-22T17:20:29.472515Z","iopub.status.idle":"2026-09-22T17:21:13.013556Z","shell.execute_reply":"2026-09-22T17:21:13.012676Z"},"papermill":{"duration":43.558385,"end_time":"2026-09-22T17:21:13.027208+00:00","exception":false,"start_time":"2026-09-22T17:20:29.468823+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["            group target       baseline  n_train  val_bal