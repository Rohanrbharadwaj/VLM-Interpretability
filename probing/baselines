torizer(ngram_range=(1, 2), min_df=2, max_features=5000)\n","    Xtr = vec.fit_transform(train[\"question_text\"])\n","    return _fit_eval(Xtr, train[y_col], vec.transform(val[\"question_text\"]), val[y_col],\n","                      vec.transform(test[\"question_text\"]), test[y_col])\n","\n","\n","def eval_vision(df, y_col, image_features):\n","    train, val, test = df[df.split == \"train\"], df[df.split == \"val\"], df[df.split == \"test\"]\n","    feat = lambda sub: np.stack([image_features[i][\"pooled_encoder_embedding\"].float().numpy() for i in sub[\"image_id\"]])\n","    Xtr, Xva, Xte = feat(train), feat(val), feat(test)\n","    scaler = StandardScaler().fit(Xtr)\n","    return _fit_eval(scaler.transform(Xtr), train[y_col], scaler.transform(Xva), val[y_col],\n","                      scaler.transform(Xte), test[y_col])\n","\n","\n","def eval_logit_gap(df):\n","    out = {}\n","    for name in [\"val\", \"test\"]:\n","        sub = df[df.split == name]\n","        if sub[\"false_yes\"].nunique() < 2:\n","            continue\n","        auc = roc_auc_score(sub[\"false_yes\"], sub[\"logit_gap\"])\n","        out[f\"{name}_auroc\"] = round(float(max(auc, 1 - auc)), 4)\n","    return out"]},{"cell_type":"code","execution_count":4,"id":"88901032","metadata":{"execution":{"iopub.execute_input":"2026-09-22T12:56:12.239333Z","iopub.status.busy":"2026-09-22T12:56:12.238972Z","iopub.status.idle":"2026-09-22T12:56:33.947843Z","shell.execute_reply":"2026-09-22T12:56:33.946576Z"},"papermill":{"duration":21.715176,"end_time":"2026-09-22T12:56:33.950682+00:00","exception":false,"start_time":"2026-09-22T12:56:12.235506+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["     type target       baseline  n_train  val_bal_acc  test_bal_acc  val_auroc  test_auroc\n","attribute      A       majority   5341.0       0.5000        0.5004        NaN         NaN\n","attribute      A         source   5341.0       0.5000        0.5000 