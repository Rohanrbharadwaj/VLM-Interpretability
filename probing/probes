.234756Z"},"papermill":{"duration":0.011484,"end_time":"2026-09-22T17:12:56.236903+00:00","exception":false,"start_time":"2026-09-22T17:12:56.225419+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["import warnings\n","from sklearn.exceptions import ConvergenceWarning\n","\n","\n","def _fit_once(Xtr_s, ytr, C, max_iter):\n","    with warnings.catch_warnings():\n","        warnings.simplefilter(\"ignore\", category=ConvergenceWarning)\n","        clf = LogisticRegression(class_weight=\"balanced\", C=C, max_iter=max_iter)\n","        clf.fit(Xtr_s, ytr)\n","    return clf, int(clf.n_iter_[0]) < max_iter\n","\n","\n","def fit_eval_layer(Xtr, ytr, Xval, yval, Xte, yte, C=0.01, max_iter=3000):\n","    if ytr.nunique() < 2:\n","        return None\n","    scaler = StandardScaler().fit(Xtr)\n","    Xtr_s = scaler.transform(Xtr)\n","\n","    clf, converged = _fit_once(Xtr_s, ytr, C, max_iter)\n","    if not converged:\n","        clf, converged = _fit_once(Xtr_s, ytr, C / 10, max_iter * 2)\n","\n","    out = {\"converged\": converged}\n","    for name, X, y in [(\"val\", Xval, yval), (\"test\", Xte, yte)]:\n","        if len(y) == 0 or y.nunique() < 2:\n","            out[f\"{name}_bal_acc\"], out[f\"{name}_auroc\"] = None, None\n","            continue\n","        Xs = scaler.transform(X)\n","        pred, proba = clf.predict(Xs), clf.predict_proba(Xs)[:, 1]\n","        out[f\"{name}_bal_acc\"] = round(float(balanced_accuracy_score(y, pred)), 4)\n","        out[f\"{name}_auroc\"] = round(float(roc_auc_score(y, proba)), 4)\n","    return out"]},{"cell_type":"code","execution_count":5,"id":"0f568240","metadata":{"execution":{"iopub.execute_input":"2026-09-22T17:12:56.241314Z","iopub.status.busy":"2026-09-22T17:12:56.241068Z","iopub.status.idle":"2026-09-22T17:40:31.896613Z","shell.execute_reply":"2026-09-22T17:40:31.895293Z"},"papermill":{"duration":1655.662265,"end_time":"2026-09-22T17:40:31.900852+00:00","exception":false,"start_time":"2026-09-22T17:12:56.238