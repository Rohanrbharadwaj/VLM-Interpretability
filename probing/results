{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","file_extension":".py","pygments_lexer":"ipython3","nbconvert_exporter":"python","codemirror_mode":{"name":"ipython","version":3}},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"datasetVersion","sourceId":19878379},{"sourceType":"datasetVersion","sourceId":19878389},{"sourceType":"datasetVersion","sourceId":19878410},{"sourceType":"datasetVersion","sourceId":19893959},{"sourceType":"datasetVersion","sourceId":19876945}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"8e0cd264","cell_type":"code","source":"import os\nimport time\nimport json\nimport warnings\nimport numpy as np\nimport pandas as pd\nimport torch\nimport matplotlib.pyplot as plt\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import balanced_accuracy_score, roc_auc_score\nfrom sklearn.exceptions import ConvergenceWarning\n\nINPUT = \"/kaggle/input/datasets/nocturnalnerd18\"\nTYPES = [\"attribute\", \"object\", \"relation\"]\nUSERNAME = \"nocturnalnerd18\"\nNUM_LAYERS = 33\nN_BOOT = 500\n\nwith open(f\"{INPUT}/vlm-labeled-examples/labeled_examples.json\") as f:\n    labels = pd.DataFrame(json.load(f))\nlabels = labels[labels[\"cache\"] == \"question_aware\"].copy()\nlabels[\"false_yes\"] = labels[\"false_yes\"].astype(int)\n\nwith open(f\"{INPUT}/probe-baselines/baseline_results.json\") as f:\n    baseline_df = pd.DataFrame(json.load(f))\n\ntype_data = {}\nfor t in TYPES:\n    with open(f\"{INPUT}/probe-features-{t}/question_ids.json\") as f:\n        qids = json.load(f)\n    p1 = torch.load(f\"{INPUT}/probe-features-{t}/p1.pt\", mmap=True)\n    p2 = torch.load(f\"{INPUT}/probe-features-{t}/p2.pt\", mmap=True)\n    type_data[t] = {\"row_of\": pd.Series(range(len(qids)), index=qids), \"p1\": p1, \"p2\": p2}\n\nGROUPS = [\n    (\"attribute\", None, \"attribute\"),\n    (\"object\", None, \"object\"),\n    (\"relation\", None, \"relation_all\"),\n    (\"relation\", \"amber\", \"relation_amber\"),\n    (\"relation\", \"reefknot\", \"relation_reefknot\"),\n]\n\n\ndef group_frame(t, source_filter):\n    df = labels[labels[\"hallucination_type\"] == t].copy()\n    if source_filter is not None:\n        df = df[df[\"source\"] == source_filter]\n    df[\"row\"] = df[\"question_id\"].map(type_data[t][\"row_of\"])\n    assert df[\"row\"].notna().all()\n    df[\"row\"] = df[\"row\"].astype(int)\n    return df.reset_index(drop=True)","metadata":{},"outputs":[],"execution_count":null},{"id":"a9199ae1","cell_type":"code","source":"def _fit_once(Xtr_s, ytr, C, max_iter):\n    with warnings.catch_warnings():\n        warnings.simplefilter(\"ignore\", category=ConvergenceWarning)\n        clf = LogisticRegression(class_weight=\"balanced\", C=C, max_iter=max_iter)\n        clf.fit(Xtr_s, ytr)\n    return clf, int(clf.n_iter_[0]) < max_iter\n\n\ndef fit_layer(Xtr, ytr, C=0.01, max_iter=3000):\n    scaler = StandardScaler().fit(Xtr)\n    Xtr_s = scaler.transform(Xtr)\n    clf, converged = _fit_once(Xtr_s, ytr, C, max_iter)\n    if not converged:\n        clf, converged = _fit_once(Xtr_s, ytr, C / 10, max_iter * 2)\n    return clf, scaler, converged\n\n\ndef bootstrap_ci(y, pred, proba, image_ids, n_boot, rng):\n    image_to_idx = {}\n    for i, im in enumerate(image_ids):\n        image_to_idx.setdefault(im, []).append(i)\n    unique_images = np.array(list(image_to_idx.keys()))\n\n    boot_bal, boot_auc = [], []\n    for _ in range(n_boot):\n        sampled = rng.choice(unique_images, size=len(unique_images), replace=True)\n        idx = np.concatenate([image_to_idx[im] for im in sampled])\n        y_b, pr_b, p_b = y[idx], pred[idx], proba[idx]\n        if len(np.unique(y_b)) < 2:\n            continue\n        boot_bal.append(balanced_accuracy_score(y_b, pr_b))\n        boot_auc.append(roc_auc_score(y_b, p_b))\n    lo_hi = lambda arr: (float(np.percentile(arr, 2.5)), float(np.percentile(arr, 97.5))) if arr else (None, None)\n    bal_lo, bal_hi = lo_hi(boot_bal)\n    auc_lo, auc_hi = lo_hi(boot_auc)\n    return bal_lo, bal_hi, auc_lo, auc_hi","metadata":{},"outputs":[],"execution_count":null},{"id":"2bab90cf","cell_type":"code","source":"rng = np.random.default_rng(123)\ncurve_rows = []\n\nfor t, src, group_name in GROUPS:\n    df = group_frame(t, src)\n    mask = (df[\"model_answer\"] == \"yes\").to_numpy()\n    sub_df = df[mask].reset_index(drop=True)\n    tr = (sub_df.split == \"train\").to_numpy()\n    va = (sub_df.split == \"val\").to_numpy()\n    te = (sub_df.split == \"test\").to_numpy()\n    ytr, yte = sub_df.loc[tr, \"false_yes\"].to_numpy(), sub_df.loc[te, \"false_yes\"].to_numpy()\n    test_images = sub_df.loc[te, \"image_id\"].to_numpy()\n\n    if len(np.unique(ytr)) < 2 or te.sum() == 0:\n        print(f\"skip {group_name}: insufficient data\")\n        continue\n\n    for feat in [\"p1\", \"p2\"]:\n        X_all = type_data[t][feat][df[\"row\"].to_numpy()].float().numpy()\n        X_sub = X_all[mask]\n        t0 = time.time()\n        for layer in range(NUM_LAYERS):\n            clf, scaler, converged = fit_layer(X_sub[tr, layer, :], ytr)\n            proba = clf.predict_proba(scaler.transform(X_sub[te, layer, :]))[:, 1]\n            pred = clf.predict(scaler.transform(X_sub[te, layer, :]))\n            point_bal = balanced_accuracy_score(yte, pred)\n            point_auc = roc_auc_score(yte, proba)\n            bal_lo, bal_hi, auc_lo, auc_hi = bootstrap_ci(yte, pred, proba, test_images, N_BOOT, rng)\n            curve_rows.append({\n                \"group\": group_name, \"feature\": feat, \"layer\": layer,\n                \"bal_acc\": round(float(point_bal), 4), \"auroc\": round(float(point_auc), 4),\n                \"bal_acc_lo\": round(bal_lo, 4) if bal_lo is not None else None,\n                \"bal_acc_hi\": round(bal_hi, 4) if bal_hi is not None else None,\n                \"auroc_lo\": round(auc_lo, 4) if auc_lo is not None else None,\n                \"auroc_hi\": round(auc_hi, 4) if auc_hi is not None else None,\n                \"converged\": converged,\n            })\n        del X_all\n        print(f\"{group_name:18s} {feat}: done in {time.time()-t0:.0f}s\")\n\ncurve_df = pd.DataFrame(curve_rows)","metadata":{},"outputs":[],"execution_count":null},{"id":"981a8b25","cell_type":"code","source":"PLOT_DIR = \"/kaggle/working/plots\"\nos.makedirs(PLOT_DIR, exist_ok=True)\nCOLORS = {\"p1\": \"#1f77b4\", \"p2\": \"#d62728\"}\nBASELINE_STYLES = {\"text\": (\"gray\", \"--\"), \"vision_encoder\": (\"green\", \":\"), \"logit_gap\": (\"purple\", \"-.\")}\n\nfor _, _, group_name in GROUPS:\n    fig, ax = plt.subplots(figsize=(8, 5))\n    for feat in [\"p1\", \"p2\"]:\n        rows = curve_df[(curve_df.group == group_name) & (curve_df.feature == feat)].sort_values(\"layer\")\n        if rows.empty:\n            continue\n        ax.plot(rows[\"layer\"], rows[\"auroc\"], label=feat, color=COLORS[feat])\n        ax.fill_between(rows[\"layer\"], rows[\"auroc_lo\"], rows[\"auroc_hi\"], color=COLORS[feat], alpha=0.15)\n\n    base_rows = baseline_df[(baseline_df.group == group_name) & (baseline_df.target == \"B\")]\n    for name, (color, style) in BASELINE_STYLES.items():\n        vals = base_rows[base_rows.baseline == name][\"test_auroc\"].values\n        if len(vals) and vals[0] is not None:\n            ax.axhline(vals[0], color=color, linestyle=style, linewidth=1, label=f\"{name} baseline\")\n\n    ax.set_xlabel(\"Layer\")\n    ax.set_ylabel(\"Test AUROC (false-yes vs true-yes)\")\n    ax.set_title(group_name)\n    ax.set_ylim(0.3, 1.0)\n    ax.legend(fontsize=8)\n    fig.tight_layout()\n    fig.savefig(f\"{PLOT_DIR}/{group_name}_layerwise.png\", dpi=150)\n    plt.show()\n    plt.close(fig)","metadata":{},"outputs":[],"execution_count":null},{"id":"83f58f08","cell_type":"code","source":"OUT = \"/kaggle/working/probe_layer_curves\"\nos.makedirs(OUT, exist_ok=True)\n\ncurve_df.to_json(f\"{OUT}/layer_curve_with_ci.json\", orient=\"records\")\nfor f in os.listdir(PLOT_DIR):\n    import shutil\n    shutil.copy(f\"{PLOT_DIR}/{f}\", f\"{OUT}/{f}\")\n\nslug = \"probe-layer-curves\"\nwith open(f\"{OUT}/dataset-metadata.json\", \"w\") as f:\n    json.dump({\"title\": slug, \"id\": f\"{USERNAME}/{slug}\", \"licenses\": [{\"name\": \"CC0-1.0\"}]}, f)\n\n!kaggle datasets create -p {OUT}","metadata":{},"outputs":[],"execution_count":null}]}