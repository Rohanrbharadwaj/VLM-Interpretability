=\"balanced\", C=C, max_iter=max_iter)\n","        clf.fit(Xtr_s, ytr)\n","    return clf, int(clf.n_iter_[0]) < max_iter\n","\n","\n","def fit_layer(Xtr, ytr, C=0.01, max_iter=3000):\n","    scaler = StandardScaler().fit(Xtr)\n","    Xtr_s = scaler.transform(Xtr)\n","    clf, converged = _fit_once(Xtr_s, ytr, C, max_iter)\n","    if not converged:\n","        clf, converged = _fit_once(Xtr_s, ytr, C / 10, max_iter * 2)\n","    return clf, scaler, converged"]},{"cell_type":"code","execution_count":4,"id":"4b3b354b","metadata":{"execution":{"iopub.execute_input":"2026-09-22T18:20:55.852403Z","iopub.status.busy":"2026-09-22T18:20:55.852041Z","iopub.status.idle":"2026-09-22T18:24:30.132933Z","shell.execute_reply":"2026-09-22T18:24:30.130749Z"},"papermill":{"duration":214.297593,"end_time":"2026-09-22T18:24:30.1454+00:00","exception":false,"start_time":"2026-09-22T18:20:55.847807+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["            group target feature  layer  n_test_images  n_test_rows  point_bal_acc  point_auroc  bal_acc_lo  bal_acc_hi  auroc_lo  auroc_hi  converged\n","        attribute      A      p1     19            152         1135         0.8934       0.9620      0.8728      0.9130    0.9491    0.9727       True\n","        attribute      B      p1     18            152          791         0.8708       0.9405      0.8430      0.8972    0.9191    0.9576       True\n","        attribute      A      p2     24            152         1135         0.8846       0.9584      0.8614      0.9069    0.9447    0.9697       True\n","        attribute      B      p2     25            152          791         0.8356       0.9319      0.8022      0.8685    0.9107    0.9501       True\n","           object      A      p1     14             75          450         0.9156       0.9784      0.8911      0.9378    0.9673    0.9880       True\n","           object      B      p1     10             75          232         0.806