{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","file_extension":".py","pygments_lexer":"ipython3","nbconvert_exporter":"python","codemirror_mode":{"name":"ipython","version":3}},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"datasetVersion","sourceId":19878379},{"sourceType":"datasetVersion","sourceId":19878389},{"sourceType":"datasetVersion","sourceId":19878410},{"sourceType":"datasetVersion","sourceId":19895209},{"sourceType":"datasetVersion","sourceId":19876945}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"888e38ad","cell_type":"code","source":"import os\nimport time\nimport json\nimport warnings\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import balanced_accuracy_score, roc_auc_score\nfrom sklearn.exceptions import ConvergenceWarning\n\nINPUT = \"/kaggle/input/datasets/nocturnalnerd18\"\nTYPES = [\"attribute\", \"object\", \"relation\"]\nUSERNAME = \"nocturnalnerd18\"\nNUM_LAYERS = 33\n\nwith open(f\"{INPUT}/vlm-labeled-examples/labeled_examples.json\") as f:\n    labels = pd.DataFrame(json.load(f))\nlabels = labels[labels[\"cache\"] == \"question_aware\"].copy()\nlabels[\"truth\"] = labels[\"ground_truth_answer\"].str.strip().str.lower()\nlabels[\"is_yes_truth\"] = (labels[\"truth\"] == \"yes\").astype(int)\nlabels[\"false_yes\"] = labels[\"false_yes\"].astype(int)\n\nwith open(f\"{INPUT}/probe-results/best_layer_summary.json\") as f:\n    picked_df = pd.DataFrame(json.load(f))\nprint(len(labels), \"labeled rows |\", len(picked_df), \"picked layers loaded\")","metadata":{},"outputs":[],"execution_count":null},{"id":"15edb767","cell_type":"code","source":"type_data = {}\nfor t in TYPES:\n    with open(f\"{INPUT}/probe-features-{t}/question_ids.json\") as f:\n        qids = json.load(f)\n    p1 = torch.load(f\"{INPUT}/probe-features-{t}/p1.pt\", mmap=True)\n    p2 = torch.load(f\"{INPUT}/probe-features-{t}/p2.pt\", mmap=True)\n    type_data[t] = {\"row_of\": pd.Series(range(len(qids)), index=qids), \"p1\": p1, \"p2\": p2}\n\nGROUPS = [\n    (\"attribute\", None, \"attribute\"),\n    (\"object\", None, \"object\"),\n    (\"relation\", None, \"relation_all\"),\n    (\"relation\", \"amber\", \"relation_amber\"),\n    (\"relation\", \"reefknot\", \"relation_reefknot\"),\n]\n\n\ndef group_frame(t, source_filter):\n    df = labels[labels[\"hallucination_type\"] == t].copy()\n    if source_filter is not None:\n        df = df[df[\"source\"] == source_filter]\n    df[\"row\"] = df[\"question_id\"].map(type_data[t][\"row_of\"])\n    assert df[\"row\"].notna().all()\n    df[\"row\"] = df[\"row\"].astype(int)\n    return df.reset_index(drop=True)","metadata":{},"outputs":[],"execution_count":null},{"id":"9d195cee","cell_type":"code","source":"def _fit_once(Xtr_s, ytr, C, max_iter):\n    with warnings.catch_warnings():\n        warnings.simplefilter(\"ignore\", category=ConvergenceWarning)\n        clf = LogisticRegression(class_weight=\"balanced\", C=C, max_iter=max_iter)\n        clf.fit(Xtr_s, ytr)\n    return clf, int(clf.n_iter_[0]) < max_iter\n\n\ndef fit_layer(Xtr, ytr, C=0.01, max_iter=3000):\n    scaler = StandardScaler().fit(Xtr)\n    Xtr_s = scaler.transform(Xtr)\n    clf, converged = _fit_once(Xtr_s, ytr, C, max_iter)\n    if not converged:\n        clf, converged = _fit_once(Xtr_s, ytr, C / 10, max_iter * 2)\n    return clf, scaler, converged","metadata":{},"outputs":[],"execution_count":null},{"id":"3368a83c","cell_type":"code","source":"N_BOOT = 1000\nrng_boot = np.random.default_rng(42)\nbootstrap_rows = []\n\nfor t, src, group_name in GROUPS:\n    df = group_frame(t, src)\n    for feat in [\"p1\", \"p2\"]:\n        X_all = type_data[t][feat][df[\"row\"].to_numpy()].float().numpy()\n\n        for target, y_col in [(\"A\", \"is_yes_truth\"), (\"B\", \"false_yes\")]:\n            picked = picked_df[(picked_df.group == group_name) & (picked_df.target == target) & (picked_df.feature == feat)]\n            if picked.empty:\n                continue\n            layer = int(picked.iloc[0][\"layer\"])\n\n            if target == \"A\":\n                sub_df, X_sub = df, X_all\n            else:\n                mask = (df[\"model_answer\"] == \"yes\").to_numpy()\n                sub_df, X_sub = df[mask].reset_index(drop=True), X_all[mask]\n\n            tr = (sub_df.split == \"train\").to_numpy()\n            te = (sub_df.split == \"test\").to_numpy()\n            Xtr, ytr = X_sub[tr, layer, :], sub_df.loc[tr, y_col]\n            Xte, yte = X_sub[te, layer, :], sub_df.loc[te, y_col].to_numpy()\n            test_images = sub_df.loc[te, \"image_id\"].to_numpy()\n\n            clf, scaler, converged = fit_layer(Xtr, ytr)\n            proba_te = clf.predict_proba(scaler.transform(Xte))[:, 1]\n            pred_te = clf.predict(scaler.transform(Xte))\n\n            point_bal_acc = balanced_accuracy_score(yte, pred_te)\n            point_auroc = roc_auc_score(yte, proba_te)\n\n            image_to_idx = {}\n            for i, im in enumerate(test_images):\n                image_to_idx.setdefault(im, []).append(i)\n            unique_images = np.array(list(image_to_idx.keys()))\n\n            boot_bal, boot_auc = [], []\n            for _ in range(N_BOOT):\n                sampled_images = rng_boot.choice(unique_images, size=len(unique_images), replace=True)\n                idx = np.concatenate([image_to_idx[im] for im in sampled_images])\n                y_b, pr_b, p_b = yte[idx], pred_te[idx], proba_te[idx]\n                if len(np.unique(y_b)) < 2:\n                    continue\n                boot_bal.append(balanced_accuracy_score(y_b, pr_b))\n                boot_auc.append(roc_auc_score(y_b, p_b))\n\n            bootstrap_rows.append({\n                \"group\": group_name, \"target\": target, \"feature\": feat, \"layer\": layer,\n                \"n_test_images\": len(unique_images), \"n_test_rows\": int(te.sum()),\n                \"point_bal_acc\": round(float(point_bal_acc), 4), \"point_auroc\": round(float(point_auroc), 4),\n                \"bal_acc_lo\": round(float(np.percentile(boot_bal, 2.5)), 4) if boot_bal else None,\n                \"bal_acc_hi\": round(float(np.percentile(boot_bal, 97.5)), 4) if boot_bal else None,\n                \"auroc_lo\": round(float(np.percentile(boot_auc, 2.5)), 4) if boot_auc else None,\n                \"auroc_hi\": round(float(np.percentile(boot_auc, 97.5)), 4) if boot_auc else None,\n                \"converged\": converged,\n            })\n        del X_all\n\nbootstrap_df = pd.DataFrame(bootstrap_rows)\npd.set_option(\"display.width\", 160)\nprint(bootstrap_df.to_string(index=False))","metadata":{},"outputs":[],"execution_count":null},{"id":"e5620239","cell_type":"code","source":"N_PERM = 25\nPERM_LAYERS = list(range(NUM_LAYERS))\nrng_perm = np.random.default_rng(7)\nperm_rows = []\n\nfor t, src, group_name in GROUPS:\n    df = group_frame(t, src)\n    for feat in [\"p1\", \"p2\"]:\n        X_all = type_data[t][feat][df[\"row\"].to_numpy()].float().numpy()\n        mask = (df[\"model_answer\"] == \"yes\").to_numpy()\n        sub_df, X_sub = df[mask].reset_index(drop=True), X_all[mask]\n\n        tr = (sub_df.split == \"train\").to_numpy()\n        va = (sub_df.split == \"val\").to_numpy()\n        te = (sub_df.split == \"test\").to_numpy()\n        ytr_real = sub_df.loc[tr, \"false_yes\"].to_numpy()\n        yval_real = sub_df.loc[va, \"false_yes\"].to_numpy()\n        yte_real = sub_df.loc[te, \"false_yes\"].to_numpy()\n\n        picked = picked_df[(picked_df.group == group_name) & (picked_df.target == \"B\") & (picked_df.feature == feat)]\n        observed_auroc = float(picked.iloc[0][\"test_auroc\"]) if not picked.empty else None\n\n        t0 = time.time()\n        null_aurocs = []\n        for p_i in range(N_PERM):\n            ytr_perm = rng_perm.permutation(ytr_real)\n            best_val, best_test_auc = -1.0, None\n            for layer in PERM_LAYERS:\n                clf, scaler, _ = fit_layer(X_sub[tr, layer, :], ytr_perm)\n                pred_val = clf.predict(scaler.transform(X_sub[va, layer, :]))\n                val_bal = balanced_accuracy_score(yval_real, pred_val)\n                if val_bal > best_val:\n                    best_val = val_bal\n                    if len(np.unique(yte_real)) > 1:\n                        proba_test = clf.predict_proba(scaler.transform(X_sub[te, layer, :]))[:, 1]\n                        best_test_auc = roc_auc_score(yte_real, proba_test)\n            if best_test_auc is not None:\n                null_aurocs.append(best_test_auc)\n\n        elapsed = time.time() - t0\n        null_arr = np.array(null_aurocs)\n        p_value = (int((null_arr >= observed_auroc).sum()) + 1) / (len(null_arr) + 1) if len(null_arr) and observed_auroc is not None else None\n\n        perm_rows.append({\n            \"group\": group_name, \"feature\": feat, \"observed_test_auroc\": observed_auroc,\n            \"null_mean\": round(float(null_arr.mean()), 4) if len(null_arr) else None,\n            \"null_p95\": round(float(np.percentile(null_arr, 95)), 4) if len(null_arr) else None,\n            \"n_perm\": len(null_arr), \"p_value\": round(p_value, 4) if p_value is not None else None,\n        })\n        print(f\"{group_name:18s} {feat}: observed {observed_auroc} | null mean {perm_rows[-1]['null_mean']} \"\n              f\"p95 {perm_rows[-1]['null_p95']} | p={perm_rows[-1]['p_value']} ({elapsed:.0f}s)\")\n        del X_all\n\nperm_df = pd.DataFrame(perm_rows)","metadata":{},"outputs":[],"execution_count":null},{"id":"b189a0a3","cell_type":"code","source":"OUT = \"/kaggle/working/probe_robustness\"\nos.makedirs(OUT, exist_ok=True)\n\nbootstrap_df.to_json(f\"{OUT}/bootstrap_ci.json\", orient=\"records\")\nperm_df.to_json(f\"{OUT}/permutation_null.json\", orient=\"records\")\n\nslug = \"probe-robustness\"\nwith open(f\"{OUT}/dataset-metadata.json\", \"w\") as f:\n    json.dump({\"title\": slug, \"id\": f\"{USERNAME}/{slug}\", \"licenses\": [{\"name\": \"CC0-1.0\"}]}, f)\n\n!kaggle datasets create -p {OUT}","metadata":{},"outputs":[],"execution_count":null}]}