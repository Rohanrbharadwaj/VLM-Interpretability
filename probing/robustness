ay(list(image_to_idx.keys()))\n","\n","            boot_bal, boot_auc = [], []\n","            for _ in range(N_BOOT):\n","                sampled_images = rng_boot.choice(unique_images, size=len(unique_images), replace=True)\n","                idx = np.concatenate([image_to_idx[im] for im in sampled_images])\n","                y_b, pr_b, p_b = yte[idx], pred_te[idx], proba_te[idx]\n","                if len(np.unique(y_b)) < 2:\n","                    continue\n","                boot_bal.append(balanced_accuracy_score(y_b, pr_b))\n","                boot_auc.append(roc_auc_score(y_b, p_b))\n","\n","            bootstrap_rows.append({\n","                \"group\": group_name, \"target\": target, \"feature\": feat, \"layer\": layer,\n","                \"n_test_images\": len(unique_images), \"n_test_rows\": int(te.sum()),\n","                \"point_bal_acc\": round(float(point_bal_acc), 4), \"point_auroc\": round(float(point_auroc), 4),\n","                \"bal_acc_lo\": round(float(np.percentile(boot_bal, 2.5)), 4) if boot_bal else None,\n","                \"bal_acc_hi\": round(float(np.percentile(boot_bal, 97.5)), 4) if boot_bal else None,\n","                \"auroc_lo\": round(float(np.percentile(boot_auc, 2.5)), 4) if boot_auc else None,\n","                \"auroc_hi\": round(float(np.percentile(boot_auc, 97.5)), 4) if boot_auc else None,\n","                \"converged\": converged,\n","            })\n","        del X_all\n","\n","bootstrap_df = pd.DataFrame(bootstrap_rows)\n","pd.set_option(\"display.width\", 160)\n","print(bootstrap_df.to_string(index=False))"]},{"cell_type":"code","execution_count":5,"id":"438745c3","metadata":{"execution":{"iopub.execute_input":"2026-09-22T18:24:30.154127Z","iopub.status.busy":"2026-09-22T18:24:30.152908Z","iopub.status.idle":"2026-09-23T00:04:49.126527Z","shell.execute_reply":"2026-09-23T00:04:49.078838Z"},"papermill":{"duration":20418.989783,"end_time":"2026-09-23T00:04:49.13756+00:00","exception":false,"start_ti