{"metadata":{"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","file_extension":".py","pygments_lexer":"ipython3","nbconvert_exporter":"python","codemirror_mode":{"name":"ipython","version":3}},"kaggle":{"accelerator":"none","dataSources":[{"sourceType":"datasetVersion","sourceId":19876945},{"sourceType":"datasetVersion","sourceId":19878410},{"sourceType":"datasetVersion","sourceId":19893959},{"sourceType":"datasetVersion","sourceId":19895209}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":5,"nbformat":4,"cells":[{"id":"f7903f9e","cell_type":"code","source":"import os\nimport json\nimport warnings\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.metrics import balanced_accuracy_score, roc_auc_score\nfrom sklearn.exceptions import ConvergenceWarning\n\nINPUT = \"/kaggle/input/datasets/nocturnalnerd18\"\nUSERNAME = \"nocturnalnerd18\"\n\nwith open(f\"{INPUT}/vlm-labeled-examples/labeled_examples.json\") as f:\n    labels = pd.DataFrame(json.load(f))\nlabels = labels[(labels[\"cache\"] == \"question_aware\") & (labels[\"hallucination_type\"] == \"relation\")].copy()\nlabels[\"false_yes\"] = labels[\"false_yes\"].astype(int)\n\nwith open(f\"{INPUT}/probe-results/best_layer_summary.json\") as f:\n    picked_df = pd.DataFrame(json.load(f))\n\nwith open(f\"{INPUT}/probe-baselines/baseline_results.json\") as f:\n    baseline_df = pd.DataFrame(json.load(f))\n\nwith open(f\"{INPUT}/probe-features-relation/question_ids.json\") as f:\n    qids = json.load(f)\nrow_of = pd.Series(range(len(qids)), index=qids)\np1 = torch.load(f\"{INPUT}/probe-features-relation/p1.pt\", mmap=True)\np2 = torch.load(f\"{INPUT}/probe-features-relation/p2.pt\", mmap=True)\nlabels[\"row\"] = labels[\"question_id\"].map(row_of)\nassert labels[\"row\"].notna().all()\nlabels[\"row\"] = labels[\"row\"].astype(int)\nprint(len(labels), \"relation rows |\", p1.shape)","metadata":{},"outputs":[],"execution_count":null},{"id":"dd6e902b","cell_type":"code","source":"def _fit_once(Xtr_s, ytr, C, max_iter):\n    with warnings.catch_warnings():\n        warnings.simplefilter(\"ignore\", category=ConvergenceWarning)\n        clf = LogisticRegression(class_weight=\"balanced\", C=C, max_iter=max_iter)\n        clf.fit(Xtr_s, ytr)\n    return clf, int(clf.n_iter_[0]) < max_iter\n\n\ndef fit_layer(Xtr, ytr, C=0.01, max_iter=3000):\n    scaler = StandardScaler().fit(Xtr)\n    Xtr_s = scaler.transform(Xtr)\n    clf, converged = _fit_once(Xtr_s, ytr, C, max_iter)\n    if not converged:\n        clf, converged = _fit_once(Xtr_s, ytr, C / 10, max_iter * 2)\n    return clf, scaler, converged\n\n\ndef bootstrap_ci(y, pred, proba, image_ids, n_boot=1000, seed=42):\n    rng = np.random.default_rng(seed)\n    image_to_idx = {}\n    for i, im in enumerate(image_ids):\n        image_to_idx.setdefault(im, []).append(i)\n    unique_images = np.array(list(image_to_idx.keys()))\n\n    boot_bal, boot_auc = [], []\n    for _ in range(n_boot):\n        sampled = rng.choice(unique_images, size=len(unique_images), replace=True)\n        idx = np.concatenate([image_to_idx[im] for im in sampled])\n        y_b, pr_b, p_b = y[idx], pred[idx], proba[idx]\n        if len(np.unique(y_b)) < 2:\n            continue\n        boot_bal.append(balanced_accuracy_score(y_b, pr_b))\n        boot_auc.append(roc_auc_score(y_b, p_b))\n    return {\n        \"bal_acc_lo\": round(float(np.percentile(boot_bal, 2.5)), 4) if boot_bal else None,\n        \"bal_acc_hi\": round(float(np.percentile(boot_bal, 97.5)), 4) if boot_bal else None,\n        \"auroc_lo\": round(float(np.percentile(boot_auc, 2.5)), 4) if boot_auc else None,\n        \"auroc_hi\": round(float(np.percentile(boot_auc, 97.5)), 4) if boot_auc else None,\n    }","metadata":{},"outputs":[],"execution_count":null},{"id":"03f1f23b","cell_type":"code","source":"def yes_answer_frame(source, split=None):\n    df = labels[(labels[\"source\"] == source) & (labels[\"model_answer\"] == \"yes\")]\n    if split is not None:\n        df = df[df[\"split\"] == split]\n    return df.reset_index(drop=True)\n\n\nresults = []\nfor train_source, test_source in [(\"amber\", \"reefknot\"), (\"reefknot\", \"amber\")]:\n    for feat in [\"p1\", \"p2\"]:\n        tensor = p1 if feat == \"p1\" else p2\n        picked = picked_df[(picked_df.group == f\"relation_{train_source}\") & (picked_df.target == \"B\") & (picked_df.feature == feat)]\n        layer = int(picked.iloc[0][\"layer\"])\n        within_source_auroc = float(picked.iloc[0][\"test_auroc\"])\n\n        train_df = yes_answer_frame(train_source, split=\"train\")\n        test_df = yes_answer_frame(test_source, split=\"test\")\n\n        Xtr = tensor[train_df[\"row\"].to_numpy(), layer, :].float().numpy()\n        ytr = train_df[\"false_yes\"].to_numpy()\n        Xte = tensor[test_df[\"row\"].to_numpy(), layer, :].float().numpy()\n        yte = test_df[\"false_yes\"].to_numpy()\n\n        clf, scaler, converged = fit_layer(Xtr, ytr)\n        pred = clf.predict(scaler.transform(Xte))\n        proba = clf.predict_proba(scaler.transform(Xte))[:, 1]\n\n        point_bal_acc = balanced_accuracy_score(yte, pred)\n        point_auroc = roc_auc_score(yte, proba)\n        ci = bootstrap_ci(yte, pred, proba, test_df[\"image_id\"].to_numpy())\n\n        row = {\n            \"train_source\": train_source, \"test_source\": test_source, \"feature\": feat, \"layer\": layer,\n            \"n_train\": len(train_df), \"n_test\": len(test_df),\n            \"transfer_bal_acc\": round(float(point_bal_acc), 4), \"transfer_auroc\": round(float(point_auroc), 4),\n            \"within_source_auroc\": within_source_auroc, \"converged\": converged, **ci,\n        }\n        results.append(row)\n        print(f\"{train_source} -> {test_source}, {feat} (layer {layer}): \"\n              f\"transfer auroc {row['transfer_auroc']} [{row['auroc_lo']}, {row['auroc_hi']}] | \"\n              f\"within-source was {within_source_auroc}\")\n\ntransfer_df = pd.DataFrame(results)","metadata":{},"outputs":[],"execution_count":null},{"id":"889c70f5","cell_type":"code","source":"for _, row in transfer_df.iterrows():\n    base = baseline_df[(baseline_df.group == f\"relation_{row.test_source}\") & (baseline_df.target == \"B\")]\n    text_auc = base[base.baseline == \"text\"][\"test_auroc\"].values\n    vision_auc = base[base.baseline == \"vision_encoder\"][\"test_auroc\"].values\n    print(f\"{row.train_source:9s} -> {row.test_source:9s} {row.feature}: transfer {row.transfer_auroc} \"\n          f\"vs {row.test_source} text baseline {text_auc[0] if len(text_auc) else None} \"\n          f\"vs {row.test_source} vision baseline {vision_auc[0] if len(vision_auc) else None}\")","metadata":{},"outputs":[],"execution_count":null},{"id":"e6ced5e8","cell_type":"code","source":"OUT = \"/kaggle/working/probe_transfer\"\nos.makedirs(OUT, exist_ok=True)\n\ntransfer_df.to_json(f\"{OUT}/transfer_results.json\", orient=\"records\")\n\nslug = \"probe-transfer\"\nwith open(f\"{OUT}/dataset-metadata.json\", \"w\") as f:\n    json.dump({\"title\": slug, \"id\": f\"{USERNAME}/{slug}\", \"licenses\": [{\"name\": \"CC0-1.0\"}]}, f)\n\n!kaggle datasets create -p {OUT}","metadata":{},"outputs":[],"execution_count":null}]}