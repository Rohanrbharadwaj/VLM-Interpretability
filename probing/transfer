().all()\n","labels[\"row\"] = labels[\"row\"].astype(int)\n","print(len(labels), \"relation rows |\", p1.shape)"]},{"cell_type":"code","execution_count":2,"id":"5552822c","metadata":{"execution":{"iopub.execute_input":"2026-09-23T05:43:18.805259Z","iopub.status.busy":"2026-09-23T05:43:18.804759Z","iopub.status.idle":"2026-09-23T05:43:18.815699Z","shell.execute_reply":"2026-09-23T05:43:18.814859Z"},"papermill":{"duration":0.015392,"end_time":"2026-09-23T05:43:18.817494+00:00","exception":false,"start_time":"2026-09-23T05:43:18.802102+00:00","status":"completed"},"tags":[]},"outputs":[],"source":["def _fit_once(Xtr_s, ytr, C, max_iter):\n","    with warnings.catch_warnings():\n","        warnings.simplefilter(\"ignore\", category=ConvergenceWarning)\n","        clf = LogisticRegression(class_weight=\"balanced\", C=C, max_iter=max_iter)\n","        clf.fit(Xtr_s, ytr)\n","    return clf, int(clf.n_iter_[0]) < max_iter\n","\n","\n","def fit_layer(Xtr, ytr, C=0.01, max_iter=3000):\n","    scaler = StandardScaler().fit(Xtr)\n","    Xtr_s = scaler.transform(Xtr)\n","    clf, converged = _fit_once(Xtr_s, ytr, C, max_iter)\n","    if not converged:\n","        clf, converged = _fit_once(Xtr_s, ytr, C / 10, max_iter * 2)\n","    return clf, scaler, converged\n","\n","\n","def bootstrap_ci(y, pred, proba, image_ids, n_boot=1000, seed=42):\n","    rng = np.random.default_rng(seed)\n","    image_to_idx = {}\n","    for i, im in enumerate(image_ids):\n","        image_to_idx.setdefault(im, []).append(i)\n","    unique_images = np.array(list(image_to_idx.keys()))\n","\n","    boot_bal, boot_auc = [], []\n","    for _ in range(n_boot):\n","        sampled = rng.choice(unique_images, size=len(unique_images), replace=True)\n","        idx = np.concatenate([image_to_idx[im] for im in sampled])\n","        y_b, pr_b, p_b = y[idx], pred[idx], proba[idx]\n","        if len(np.unique(y_b)) < 2:\n","            continue\n","        boot_bal.append(balanced_accuracy_score(y_b, pr_b))\n","        boot_auc.append(roc_auc_score(y_b, p_b))\n","    return {\n","        \"bal_acc_lo\": round(float(np.percentile(boot_bal, 2.5)), 4) if boot_bal else None,\n","        \"bal_acc_hi\": round(float(np.percentile(boot_bal, 97.5)), 4) if boot_bal else None,\n","        \"auroc_lo\": round(float(np.percentile(boot_auc, 2.5)), 4) if boot_auc else None,\n","        \"auroc_hi\": round(float(np.percentile(boot_auc, 97.5)), 4) if boot_auc else None,\n","    }"]},{"cell_type":"code","execution_count":3,"id":"1037d6d4","metadata":{"execution":{"iopub.execute_input":"2026-09-23T05:43:18.822083Z","iopub.status.busy":"2026-09-23T05:43:18.821736Z","iopub.status.idle":"2026-09-23T05:43:49.167338Z","shell.execute_reply":"2026-09-23T05:43:49.166412Z"},"papermill":{"duration":30.351416,"end_time":"2026-09-23T05:43:49.170483+00:00","exception":false,"start_time":"2026-09-23T05:43:18.819067+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["amber -> reefknot, p1 (layer 25): transfer auroc 0.5373 [0.4993, 0.5737] | within-source was 0.968\n","amber -> reefknot, p2 (layer 5): transfer auroc 0.4755 [0.442, 0.5089] | within-source was 0.8625\n","reefknot -> amber, p1 (layer 14): transfer auroc 0.534 [0.3348, 0.7182] | within-source was 0.8685\n","reefknot -> amber, p2 (layer 16): transfer auroc 0.5614 [0.401, 0.7108] | within-source was 0.8877\n"]}],"source":["def yes_answer_frame(source, split=None):\n","    df = labels[(labels[\"source\"] == source) & (labels[\"model_answer\"] == \"yes\")]\n","    if split is not None:\n","        df = df[df[\"split\"] == split]\n","    return df.reset_index(drop=True)\n","\n","\n","results = []\n","for train_source, test_source in [(\"amber\", \"reefknot\"), (\"reefknot\", \"amber\")]:\n","    for feat in [\"p1\", \"p2\"]:\n","        tensor = p1 if feat == \"p1\" else p2\n","        picked = picked_df[(picked_df.group == f\"relation_{train_source}\") & (picked_df.target == \"B\") & (picked_df.feature == feat)]\n","        layer = int(picked.iloc[0][\"layer\"])\n","        within_source_auroc = float(picked.iloc[0][\"test_auroc\"])\n","\n","        train_df = yes_answer_frame(train_source, split=\"train\")\n","        test_df = yes_answer_frame(test_source, split=\"test\")\n","\n","        Xtr = tensor[train_df[\"row\"].to_numpy(), layer, :].float().numpy()\n","        ytr = train_df[\"false_yes\"].to_numpy()\n","        Xte = tensor[test_df[\"row\"].to_numpy(), layer, :].float().numpy()\n","        yte = test_df[\"false_yes\"].to_numpy()\n","\n","        clf, scaler, converged = fit_layer(Xtr, ytr)\n","        pred = clf.predict(scaler.transform(Xte))\n","        proba = clf.predict_proba(scaler.transform(Xte))[:, 1]\n","\n","        point_bal_acc = balanced_accuracy_score(yte, pred)\n","        point_auroc = roc_auc_score(yte, proba)\n","        ci = bootstrap_ci(yte, pred, proba, test_df[\"image_id\"].to_numpy())\n","\n","        row = {\n","            \"train_source\": train_source, \"test_source\": test_source, \"feature\": feat, \"layer\": layer,\n","            \"n_train\": len(train_df), \"n_test\": len(test_df),\n","            \"transfer_bal_acc\": round(float(point_bal_acc), 4), \"transfer_auroc\": round(float(point_auroc), 4),\n","            \"within_source_auroc\": within_source_auroc, \"converged\": converged, **ci,\n","        }\n","        results.append(row)\n","        print(f\"{train_source} -> {test_source}, {feat} (layer {layer}): \"\n","              f\"transfer auroc {row['transfer_auroc']} [{row['auroc_lo']}, {row['auroc_hi']}] | \"\n","              f\"within-source was {within_source_auroc}\")\n","\n","transfer_df = pd.DataFrame(results)"]},{"cell_type":"code","execution_count":4,"id":"9148e672","metadata":{"execution":{"iopub.execute_input":"2026-09-23T05:43:49.175552Z","iopub.status.busy":"2026-09-23T05:43:49.175043Z","iopub.status.idle":"2026-09-23T05:43:49.186532Z","shell.execute_reply":"2026-09-23T05:43:49.185599Z"},"papermill":